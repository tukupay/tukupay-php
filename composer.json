{
    "name": "tukupay/tukupay-php",
    "description": "Server-side PHP library for the TukuPay API",
    "type": "library",
    "license": "MIT",
    "keywords": ["tukupay", "payments", "mpesa", "kenya", "fintech", "sdk"],
    "homepage": "https://tuku.money",
    "support": {
        "issues": "https://github.com/tukupay/tukupay-php/issues",
        "source": "https://github.com/tukupay/tukupay-php"
    },
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": { "TukuPay\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "TukuPay\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
